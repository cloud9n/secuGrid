# --- SecuGrid local AI pipeline ---
LOCAL_AI_BASE_URL=http://localhost:8080/v1
LOCAL_AI_MODEL=secugrid-qwen2.5-coder-3b
AI_FALLBACK_PROVIDER=openai        # openai | gemini | none
AI_FALLBACK_ON_ERROR=true
AI_FALLBACK_ON_LOW_CONFIDENCE=true
AI_REQUEST_TIMEOUT_MS=20000
AI_CACHE_TTL_SECONDS=86400

# Existing hosted keys, now used only as fallback:
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
